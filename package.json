{
  "name": "beads-viewer",
  "version": "0.1.0",
  "description": "A local, read-only web UI for reviewing Beads epics, stories, tasks, and dependencies",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chase3c/beads-viewer.git"
  },
  "homepage": "https://github.com/chase3c/beads-viewer#readme",
  "bugs": "https://github.com/chase3c/beads-viewer/issues",
  "keywords": [
    "beads",
    "issue-tracker",
    "developer-tools",
    "viewer"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "beads-viewer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch src/server/dev.ts\" \"vite\"",
    "clean": "rimraf dist coverage",
    "build": "pnpm clean && vite build && tsup src/cli.ts --format esm --platform node --target node20 --out-dir dist",
    "start": "node dist/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "install:local": "pnpm build && npm link"
  },
  "dependencies": {
    "express": "^5.1.0",
    "open": "^10.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.0"
}
